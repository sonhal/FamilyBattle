{
	"name": "familybattle",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"generate": "tsx scripts/generate-puzzles.ts",
		"seed:sample": "tsx scripts/seed-sample.ts",
		"start": "node build",
		"sql": "tsx scripts/sql.ts",
		"backup": "tsx scripts/backup.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/luxon": "^3.7.6",
		"@types/node": "^26.6.4",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.7",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.131.0",
		"better-sqlite3": "^13.0.3",
		"luxon": "^3.7.2",
		"zod": "^4.6.5"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true,
		"esbuild@0.28.2": true
	}
}
