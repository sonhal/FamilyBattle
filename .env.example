# Copy to .env on the VPS. Never commit .env.

# Authelia headers, as forwarded by Caddy's forward_auth copy_headers.
AUTH_USER_HEADER=Remote-User
AUTH_NAME_HEADER=Remote-Name
AUTH_GROUPS_HEADER=Remote-Groups

# Authelia groups. Players need PLAYER_GROUP; admins need ADMIN_GROUP (admins can also play).
PLAYER_GROUP=familybattle
ADMIN_GROUP=familybattle-admin

# Image tag to run from GHCR: latest, a version like 1.2.0, or sha-<commit>.
FAMILYBATTLE_TAG=latest

# Docker network Caddy is attached to (used by docker-compose.yml).
PROXY_NETWORK=caddy

# Optional defense in depth: Caddy adds this header, the app rejects requests without it.
# Generate with: openssl rand -hex 32
PROXY_SECRET=

# Season calendar (Europe/Oslo). Week 1 opens at 00:00 on this Sunday.
SEASON_START=2026-10-04
SEASON_WEEKS=13

# Puzzle generation (tools container only). Leave the key out of .env and pass it
# on the command line instead if you prefer: ANTHROPIC_API_KEY=... docker compose run ...
# ANTHROPIC_API_KEY=
# Language of the words and categories players see.
PUZZLE_LANGUAGE=Norwegian Bokmål
